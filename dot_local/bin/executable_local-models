#!/bin/bash
# Optional local coding models for Ollama. Nothing is pulled automatically by
# the dotfiles; run this when you want offline models (e.g. no AI subscription).
#
#   local-models            pull the recommended models that fit this Mac's memory
#   local-models --list     show every model and whether it fits
#   local-models NAME...    pull specific models (see --list for names)
#   local-models --force NAME...   pull even if the model may not fit in memory
#   local-models --dry-run  show what would be pulled
set -euo pipefail

# name | ollama pull ref | download GB | min RAM GB | origin | notes
CATALOG=(
  "twil-8b|hf.co/webAI-Official/TwIL-8B:Q8_0|9|16|US (webAI, IBM Granite base)|small, fast coder"
  "flint-q3|hf.co/unsloth/flint-GGUF:UD-Q3_K_XL|19|32|Recursive (Unsloth quant)|best Flint for 32-47GB Macs"
  "flint-q4|flint:40b-a2b-q4_1|26|48|Recursive (official Ollama build)|"
  "flint-q8|hf.co/unsloth/flint-GGUF:Q8_0|42|64|Recursive (Unsloth quant)|"
  "gpt-oss-20b|gpt-oss:20b|14|24|US (OpenAI)|"
  "qwen3.8-27b|qwen3.8:27b-q4_K_M|18|32|China (Alibaba)|restricted origin, needs --allow-restricted-origin"
)
RESTRICTED=(qwen3.8-27b)

ram_gb=${LOCAL_MODELS_RAM_GB:-$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))}

field() { echo "$1" | cut -d'|' -f"$2"; }
entry() {
  local item
  for item in "${CATALOG[@]}"; do
    [ "$(field "$item" 1)" = "$1" ] && { echo "$item"; return 0; }
  done
  return 1
}
fits() { [ "$(field "$(entry "$1")" 4)" -le "$ram_gb" ]; }
is_restricted() {
  local name
  for name in "${RESTRICTED[@]}"; do [ "$name" = "$1" ] && return 0; done
  return 1
}

list() {
  printf "This Mac has %sGB of memory.\n\n" "$ram_gb"
  printf "%-13s %-6s %-8s %-5s %-40s %s\n" NAME SIZE MIN_RAM FITS ORIGIN NOTES
  local item name
  for item in "${CATALOG[@]}"; do
    name=$(field "$item" 1)
    printf "%-13s %-6s %-8s %-5s %-40s %s\n" "$name" "$(field "$item" 3)GB" "$(field "$item" 4)GB" \
      "$(fits "$name" && echo yes || echo no)" "$(field "$item" 5)" "$(field "$item" 6)"
  done
}

recommended() {
  local picks=(twil-8b) flint=""
  fits flint-q4 && picks+=(flint-q4) && flint=1
  fits flint-q8 && picks+=(flint-q8) && flint=1
  [ -z "$flint" ] && fits flint-q3 && picks+=(flint-q3)
  local name
  for name in "${picks[@]}"; do fits "$name" && echo "$name"; done
}

force=""
dry_run=""
allow_restricted=""
names=()
while [ $# -gt 0 ]; do
  case "$1" in
    -l|--list) list; exit 0 ;;
    -f|--force) force=1 ;;
    -n|--dry-run) dry_run=1 ;;
    --allow-restricted-origin) allow_restricted=1 ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "Unknown option: $1" >&2; exit 1 ;;
    *) names+=("$1") ;;
  esac
  shift
done

if [ ${#names[@]} -eq 0 ]; then
  while IFS= read -r name; do names+=("$name"); done < <(recommended)
  if [ ${#names[@]} -eq 0 ]; then
    echo "No catalog model fits in ${ram_gb}GB. Run 'local-models --list' and use --force to override." >&2
    exit 1
  fi
  echo "Recommended for ${ram_gb}GB: ${names[*]}"
fi

for name in "${names[@]}"; do
  if ! entry "$name" >/dev/null; then
    echo "Unknown model '$name'. Run 'local-models --list'." >&2
    exit 1
  fi
  if is_restricted "$name" && [ -z "$allow_restricted" ]; then
    echo "'$name' comes from $(field "$(entry "$name")" 5). Check your employer's policy, then re-run with --allow-restricted-origin." >&2
    exit 1
  fi
  if ! fits "$name" && [ -z "$force" ]; then
    echo "'$name' needs $(field "$(entry "$name")" 4)GB of memory and this Mac has ${ram_gb}GB. Use --force to pull anyway." >&2
    exit 1
  fi
done

if [ -n "$dry_run" ]; then
  for name in "${names[@]}"; do
    echo "would pull $name ($(field "$(entry "$name")" 2), ~$(field "$(entry "$name")" 3)GB)"
  done
  exit 0
fi

if ! command -v ollama >/dev/null 2>&1; then
  echo "==> Installing ollama"
  brew install ollama
fi

brew services start ollama >/dev/null 2>&1 || true
for _ in $(seq 1 30); do
  ollama list >/dev/null 2>&1 && break
  sleep 1
done
if ! ollama list >/dev/null 2>&1; then
  echo "The ollama server did not start. Try 'brew services restart ollama'." >&2
  exit 1
fi

for name in "${names[@]}"; do
  ref=$(field "$(entry "$name")" 2)
  echo "==> $name ($ref, ~$(field "$(entry "$name")" 3)GB)"
  ollama pull "$ref"
done

echo
echo "Done. Crush picks these up automatically under the 'Local (Ollama)' provider."
