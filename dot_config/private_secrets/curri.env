# Curri secrets and settings. See personal.env for the file format.

FJ_FALLBACK_HOST=https://forgejo.apps.curri.dev
AWS_REGION=us-east-1

SENTRY_ACCESS_TOKEN=op://Private/Sentry Access Token/credential
SENTRY_AUTH_TOKEN=$SENTRY_ACCESS_TOKEN
EXPO_ACCESS_TOKEN=op://Private/Expo Access Token/token
DD_API_KEY=op://Private/Datadog API Key/credential
DD_APPLICATION_KEY=op://Private/Datadog Application Key/credential
DD_APP_KEY=$DD_APPLICATION_KEY
K6_LOAD_TEST_EMAIL=op://Private/K6 Load Test/username
K6_LOAD_TEST_PASSWORD=op://Private/K6 Load Test/password
CURRI_READ_REPLICA_URI=op://Private/Curri Read Replica URI/credential
DATABASE_URL=$CURRI_READ_REPLICA_URI
AWS_BEARER_TOKEN_BEDROCK=op://Private/AWS Bedrock Token/credential

# Cloudflare AI Gateway and Switchboard (used by crush providers and MCP)
CF_AIG_TOKEN=op://Private/Cloudflare AI Gateway Token/Austin Token
CURRI_GATEWAY_API_KEY=$CF_AIG_TOKEN
SWITCHBOARD_MCP_TOKEN=op://Private/Switchboard MCP Token/credential
