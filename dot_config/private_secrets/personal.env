# Personal secrets and settings.
#
# Format (shared by every file in this directory):
#   NAME=op://Vault/Item/field   read from 1Password
#   NAME=$OTHER                  copy another variable from this file
#   NAME=literal value           plain, non-secret value
#   OP_ACCOUNT=my.1password.com  optional: 1Password account for the refs below
#
# chezmoi renders the contexts listed in `contexts` (see .chezmoi.toml.tmpl)
# into ~/.config/fish/conf.d/secrets.fish. The `secrets` fish function loads
# or unloads a context at runtime.

GH_PAT=op://Private/GitHub PAT/credential
GITHUB_TOKEN=$GH_PAT
OPENAI_API_KEY=op://Private/OpenAI API Key/API Key
STITCH_API_KEY=op://Private/Stitch API Key/credential
DIGITALOCEAN_ACCESS_TOKEN=op://Private/DigitalOcean Access Token/credential
DO_API_TOKEN=$DIGITALOCEAN_ACCESS_TOKEN
