# Generated by chezmoi from ~/.config/secrets/*.env for contexts: {{ .contexts }}
# Edit the .env files in the dotfiles repo, not this file.
{{- range $context := splitList "," .contexts }}
{{-   $file := printf "dot_config/private_secrets/%s.env" $context }}
{{-   if not (stat (joinPath $.chezmoi.sourceDir $file)) }}
{{-     fail (printf "unknown secrets context %q: %s does not exist" $context $file) }}
{{-   end }}
{{-   $account := "" }}

# {{ $context }}
{{-   range $raw := splitList "\n" (include $file) }}
{{-     $line := trim $raw }}
{{-     if and $line (not (hasPrefix "#" $line)) (contains "=" $line) }}
{{-       $kv := splitn "=" 2 $line }}
{{-       $key := trim $kv._0 }}
{{-       $value := trim $kv._1 }}
{{-       if eq $key "OP_ACCOUNT" }}
{{-         $account = $value }}
{{-       else if hasPrefix "op://" $value }}
{{-         $secret := "" }}
{{-         if $account }}
{{-           $secret = onepasswordRead $value $account }}
{{-         else }}
{{-           $secret = onepasswordRead $value }}
{{-         end }}
set -gx {{ $key }} '{{ $secret | replace "\\" "\\\\" | replace "'" "\\'" }}'
{{-       else if hasPrefix "$" $value }}
set -gx {{ $key }} {{ $value }}
{{-       else }}
set -gx {{ $key }} '{{ $value | replace "\\" "\\\\" | replace "'" "\\'" }}'
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}
